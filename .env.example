# SMTP credentials for the site's email delivery (all forms — Request
# Offer, Request Sample, TAROPAK, Documents, general contact).
# Without these set, submissions are still accepted and logged to the
# server console, but no email is actually sent — see src/lib/mailer.ts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional — defaults to SMTP_USER if not set.
SMTP_FROM=
